# Flask
SECRET_KEY="change-me-in-production"

# Site
SITE_NAME="Bernard Poignant"
SITE_TAGLINE="Articles & réflexions"

# Database — defaults to SQLite under instance/ if unset.
# In Kubernetes we mount a PVC at /data and set this to sqlite:////data/bpoignant.db
# DATABASE_URL="sqlite:///instance/bpoignant.db"

# Bootstrap admin (only used on the FIRST run, when the users table is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="38HytheRoad$"

# Cache
CACHE_TYPE="SimpleCache"

# Google Drive import (optional) — lets the article editor pull the body of one
# of Bernard's Google Docs straight into the editor. Read-only (drive.readonly).
# Leave unset to hide the "Importer depuis Google Drive" button.
# One-time setup: create an OAuth "Desktop app" client in Google Cloud, then do
# the consent flow once (with the drive.readonly scope, offline access) as
# Bernard.Poignant@gmail.com to obtain a refresh token.
# GOOGLE__CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE__CLIENT_SECRET="xxxxxxxx"
# GOOGLE__REFRESH_TOKEN="1//xxxxxxxx"
