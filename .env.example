# Flask
SECRET_KEY="change-me-in-production"

# Site
SITE_NAME="Bernard Poignant"
SITE_TAGLINE="Articles & réflexions"

# Database — defaults to SQLite under instance/ if unset.
# In Kubernetes we mount a PVC at /data and set this to sqlite:////data/bpoignant.db
# DATABASE_URL="sqlite:///instance/bpoignant.db"

# Bootstrap admin (only used on the FIRST run, when the users table is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="38HytheRoad$"

# Cache
CACHE_TYPE="SimpleCache"

# Newsletter deliverability — suppress bounced/complained addresses.
#
# Preferred (works even when the SendGrid account is shared by several apps):
# PULL the account-wide suppression lists. Click "Synchroniser SendGrid" on the
# admin newsletter page, or run `python sync_bounces.py` (e.g. from a cron /
# k8s CronJob). Nothing to configure beyond SENDGRID__API_KEY.
#
# Optional alternative: PUSH via the SendGrid Event Webhook, received at
# /newsletter/sendgrid/events (enable Bounced/Dropped/Blocked/Spam report). Note
# a shared account posts every app's events to that URL. Set a key and append it
# as ?key=… so only SendGrid can post.
# SENDGRID__WEBHOOK_KEY="a-long-random-string"
#
# Per-article open/click rates (admin → article → Stats): each newsletter is
# tagged with a SendGrid category (article-<id>), and the stats page pulls that
# category's opens/clicks. Enable "Open Tracking" and "Click Tracking" in
# SendGrid → Settings → Tracking for the figures to populate (going forward).

# Google Drive import (optional) — lets the article editor pull the body of one
# of Bernard's Google Docs straight into the editor. Read-only (drive.readonly).
#
# Configure this from the admin UI instead: Admin → Réglages → Google Drive.
# The OAuth client id/secret and the refresh token are stored in the database
# `config` table, and the "Connecter" button runs the consent flow for you.
#
# The env vars below are only a fallback if you'd rather not use the DB — the
# database values take precedence when both are set.
# GOOGLE__CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE__CLIENT_SECRET="xxxxxxxx"
# GOOGLE__REFRESH_TOKEN="1//xxxxxxxx"

# X / Twitter auto-posting (optional) — when an article is first published it
# is posted to X with its title, summary and link; a "Partager sur X" button
# on each article lets you post/repost manually. Dormant until all four keys
# are set. Create an app at https://developer.x.com with Read+Write permission,
# then copy its OAuth 1.0a credentials here (regenerate the access token after
# enabling Write).
# BPOIGNANT_X__API_KEY="consumer-key"
# BPOIGNANT_X__API_SECRET="consumer-secret"
# BPOIGNANT_X__ACCESS_TOKEN="access-token"
# BPOIGNANT_X__ACCESS_SECRET="access-token-secret"
