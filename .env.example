# Flask
SECRET_KEY="change-me-in-production"

# Site
SITE_NAME="Bernard Poignant"
SITE_TAGLINE="Articles & réflexions"

# Database — defaults to SQLite under instance/ if unset.
# In Kubernetes we mount a PVC at /data and set this to sqlite:////data/bpoignant.db
# DATABASE_URL="sqlite:///instance/bpoignant.db"

# Bootstrap admin (only used on the FIRST run, when the users table is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="38HytheRoad$"

# Cache
CACHE_TYPE="SimpleCache"

# Newsletter anti-spam / deliverability (optional)
# SendGrid Event Webhook receiver lives at:  /newsletter/sendgrid/events
# Point SendGrid's Event Webhook there and enable the "Bounced", "Dropped",
# "Blocked" and "Spam report" events — those addresses are then auto-suppressed
# and never e-mailed again. If you set a key below, append it to the URL as
# ?key=… so only SendGrid can post to it.
# SENDGRID__WEBHOOK_KEY="a-long-random-string"

# Google Drive import (optional) — lets the article editor pull the body of one
# of Bernard's Google Docs straight into the editor. Read-only (drive.readonly).
#
# Configure this from the admin UI instead: Admin → Réglages → Google Drive.
# The OAuth client id/secret and the refresh token are stored in the database
# `config` table, and the "Connecter" button runs the consent flow for you.
#
# The env vars below are only a fallback if you'd rather not use the DB — the
# database values take precedence when both are set.
# GOOGLE__CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE__CLIENT_SECRET="xxxxxxxx"
# GOOGLE__REFRESH_TOKEN="1//xxxxxxxx"
